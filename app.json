{
  "expo": {
    "name": "Divi",
    "slug": "divi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo_divi_sans_fond_resize.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Logo_divi_sans_fond.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "imageUrl": "./assets/Logo_divi_sans_fond.png"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bbz.divi",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo_divi_sans_fond_resize.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "app.allisson2.divi"
    },
    "owner": "allisson2",
    "plugins": [
      "expo-mail-composer"
    ],
    "extra": {
      "eas": {
        "projectId": "8ff1fdfb-9997-4807-8f5d-49ff115a28f0"
      }
    }
  }
}
